{
  "expo": {
    "name": "El Trago del Día",
    "slug": "eltragodeldia",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.eltragodeldia.app",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.eltragodeldia.app",
      "adaptiveIcon": {
        "backgroundColor": "#FDF6EC",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-image",
      "expo-localization",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FDF6EC",
          "image": "./assets/marca/icono.png",
          "imageWidth": 140
        }
      ],
      "expo-web-browser"
    ],
    "scheme": "eltragodeldia",
    "backgroundColor": "#FDF6EC",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "288c11fb-9c18-40cb-b791-74d2837efe0c"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "owner": "eltragodeldias-team"
  }
}