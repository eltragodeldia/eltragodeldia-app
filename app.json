{
  "expo": {
    "name": "El Trago del Dia",
    "slug": "eltragodeldia",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.eltragodeldia.app",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleDisplayName": "El Trago del Día",
        "NSLocationWhenInUseUsageDescription": "El Trago del Día usa tu ubicación solo para mostrarte los bares más cerca de ti en el mapa."
      }
    },
    "android": {
      "package": "com.eltragodeldia.app",
      "adaptiveIcon": {
        "backgroundColor": "#FDF6EC",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-updates",
      "expo-font",
      "expo-image",
      "expo-localization",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FDF6EC",
          "image": "./assets/marca/icono.png",
          "imageWidth": 140
        }
      ],
      "expo-web-browser",
      [
        "./plugins/nombre-android.js",
        "El Trago del Día"
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "El Trago del Día usa tu ubicación solo para mostrarte los bares más cerca de ti en el mapa."
        }
      ],
      "./plugins/vertical-opcional.js"
    ],
    "scheme": "eltragodeldia",
    "backgroundColor": "#FDF6EC",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "288c11fb-9c18-40cb-b791-74d2837efe0c"
      }
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "owner": "eltragodeldias-team",
    "updates": {
      "url": "https://u.expo.dev/288c11fb-9c18-40cb-b791-74d2837efe0c",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
